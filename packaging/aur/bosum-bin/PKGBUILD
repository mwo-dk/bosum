# Maintainer: Michael W. Olesen <michael.w.olesen@gmail.com>
# Kept in https://github.com/mwo-dk/bosum/tree/master/packaging/aur; the release workflow
# bumps pkgver and pushes it to the AUR.
pkgname=bosum-bin
pkgver=1.0.0
pkgrel=1
pkgdesc='Two-pane file manager in the Norton Commander tradition, with git status and instant search (prebuilt)'
arch=('x86_64')
url='https://github.com/mwo-dk/bosum'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'gcc-libs' 'glibc')
optdepends=('git: git status in the panels'
            'ttf-nerd-fonts-symbols-mono: file icons and git glyphs'
            'xdg-utils: open files with their default application')
provides=('bosum')
conflicts=('bosum')
_rel="$url/releases/download/v$pkgver"
source=("bosum-terminal-$pkgver.tar.gz::$_rel/bosum-terminal-v$pkgver-x86_64-unknown-linux-musl.tar.gz"
        "bosum-desktop-$pkgver.deb::$_rel/Bosum_${pkgver}_amd64.deb")
noextract=("bosum-desktop-$pkgver.deb")
sha256sums=('SKIP' 'SKIP')

package() {
  # The desktop app, its menu entry and icons, as the release's .deb lays them out.
  bsdtar -xOf "bosum-desktop-$pkgver.deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
  install -Dm755 "bosum-terminal-v$pkgver-x86_64-unknown-linux-musl/bosum" "$pkgdir/usr/bin/bosum"
  install -Dm644 "bosum-terminal-v$pkgver-x86_64-unknown-linux-musl/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
